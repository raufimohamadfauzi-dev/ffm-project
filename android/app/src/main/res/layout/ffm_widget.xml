<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#0F3832">

    <TextView
        android:id="@+id/ffm_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FFM · Asisten Offline"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ffm_widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Perintah cepat · tetap lokal"
        android:textColor="#D7F5EE"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ffm_widget_assistant"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="Asisten"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#238477" />

        <TextView
            android:id="@+id/ffm_widget_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="Ringkasan"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#176B60" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ffm_widget_transaction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="Transaksi"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#176B60" />

        <TextView
            android:id="@+id/ffm_widget_scan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="Scan nota"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#176B60" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ffm_widget_activity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="Aktivitas"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#176B60" />

        <TextView
            android:id="@+id/ffm_widget_budget"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:text="Anggaran"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:background="#176B60" />
    </LinearLayout>
</LinearLayout>
